#!/usr/bin/env bash
# Enforces Conventional Commits on the subject line (docs/13-engineering-process.md section 3).
# Enable once per clone: git config core.hooksPath .githooks
msg_file="$1"
subject="$(head -n 1 "$msg_file")"

# Allow merge/revert commits generated by git.
case "$subject" in
  Merge\ *|Revert\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|test|refactor|chore|perf|ci|build)(\([A-Za-z0-9._-]+\))?!?: .+'
if ! echo "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: subject must look like 'type(scope): summary'." >&2
  echo "  types: feat fix docs test refactor chore perf ci build" >&2
  echo "  got:   $subject" >&2
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} characters; keep it at 72 or fewer." >&2
  exit 1
fi
exit 0
