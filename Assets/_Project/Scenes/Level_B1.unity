  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1751720527}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52d235cf256cf474eb491180c1a914e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: NocturneAnnex.Interaction::NocturneAnnex.Interaction.Note
  ItemId: note_memo
  Title: Night Shift Memo
  Body: 'Filing runs on the dates, not the names.


    The first date is the day the lights failed. It is on the calendar in this room.

    The second is the day the ledger was sealed. The ledger is in the stacks.

    The third is circled in red on the calendar by the loading dock.


    The code for the Records Office is the three days, in that order, written one after another as plain numbers. The stamp for the Records Office door is in the stacks, on the far shelf.'
